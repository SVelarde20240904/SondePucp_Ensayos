        varchar password_hash
        enum rol_baile "LEADER FOLLOWER"
        enum frecuencia "REGULAR OCASIONAL EVENTUAL"
        enum estado "ACTIVO INACTIVO"
    }
    ROL_SISTEMA {
        tinyint id_rol PK
        varchar codigo "MIEMBRO EQUIPO_ENSAYOS ADMIN"
    }
    MIEMBRO_ROL {
        int id_miembro PK,FK
        tinyint id_rol PK,FK
    }
    PERMISO {
        smallint id_permiso PK
        varchar codigo UK
        enum seccion
    }
    ROL_PERMISO {
        tinyint id_rol PK,FK
        smallint id_permiso PK,FK
    }
