        int id_figura PK
        varchar nombre UK
        smallint orden
        bool activa
    }
    EVALUACION {
        int id_miembro PK,FK
        int id_figura PK,FK
        enum color "ROJO AMARILLO VERDE AZUL"
        datetime fecha_actualizacion
    }
    HISTORIAL_EVALUACION {
        int id_historial PK
        int id_miembro FK
        int id_figura FK
        enum color_anterior
        enum color_nuevo
        enum fuente "CARGA_INICIAL MENSUAL ENSAYO CORRECCION"
        bool aplicado "0 = ignorado por solo sube"
        int id_ensayo FK
        int id_periodo FK
        int registrado_por FK
        datetime fecha
    }
    PERIODO_AUTOEVALUACION {
        int id_periodo PK
        smallint anio
        tinyint mes
        datetime fecha_apertura
        datetime fecha_cierre
    }
    ENSAYO {
        int id_ensayo PK
        enum tipo "GENERAL COMPETENCIA NIVELACION EXHIBICION"
        date fecha
        time hora_inicio
        time hora_fin
        varchar lugar
        datetime cierre_confirmacion
        enum estado "BORRADOR PROGRAMADO CERRADO CANCELADO"
        text notas
    }
    ASISTENCIA {
        int id_ensayo PK,FK
        int id_miembro PK,FK
        enum confirmacion "SI NO SIN_RESPUESTA"
        varchar motivo
        enum estado_real "AP AN TJ TI FJ FI"
    }
    ENSAYO_FIGURA {
        int id_ensayo PK,FK
        int id_figura PK,FK
        enum nivel
        int dicto FK
    }
    ENSAYO_DICTANTE {
        int id_ensayo PK,FK
        int id_miembro PK,FK
    }
    ENSAYO_INDICACION {
        int id_indicacion PK
        int id_ensayo FK
        varchar texto
    }
    TIPO_ENCARGO {
        smallint id_tipo PK
        varchar nombre UK
        bool activo
    }
    ENCARGO {
        int id_encargo PK
        smallint id_tipo FK
        int id_ensayo FK
        date semana
        int responsable FK
        datetime plazo
        int cumplido_por FK
        datetime fecha_cumplimiento
        bool exonerado
        bool justificada
    }
