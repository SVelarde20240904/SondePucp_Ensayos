</div>
<%-- Pie con los emojis del team de la sección (Ensayos, Talleres, Finanzas); en Inicio y lo demás, los de los admins.
     Se editan en Miembros → Roles y permisos. --%>
<c:choose>
  <c:when test="${menu == 'Ensayos' or menu == 'Cronograma sugerido' or menu == 'Tomar asistencia' or menu == 'Figuras enseñadas'
                 or menu == 'Fichas de miembros' or menu == 'Autoevaluación' or menu == 'Confirmar asistencia' or menu == 'Mi progreso'
                 or menu == 'Responsabilidades' or menu == 'Figuras' or menu == 'Histórico'}"><c:set var="seccionPie" value="ENSAYOS"/></c:when>
  <c:when test="${menu == 'Talleres' or menu == 'Dictado de talleres' or menu == 'Pasos de talleres' or menu == 'Responsabilidades talleres'
                 or menu == 'Mi historial' or menu == 'Formulario de taller'}"><c:set var="seccionPie" value="TALLERES"/></c:when>
  <c:when test="${menu == 'Cuotas' or menu == 'Mi cuota' or menu == 'Caja'}"><c:set var="seccionPie" value="FINANZAS"/></c:when>
  <c:otherwise><c:set var="seccionPie" value="INICIO"/></c:otherwise>
</c:choose>
<footer class="team-bar"><strong>SON DE PUCP</strong><span class="emojis"><c:out value="${applicationScope.emojis[seccionPie]}"/></span></footer>
</main>
</div>
</body>
</html>
